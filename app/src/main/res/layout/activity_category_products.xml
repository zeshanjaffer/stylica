<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <TextView
        android:id="@+id/categoryTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_16sdp"
        android:textSize="@dimen/_22ssp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/searchEditText"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:hint="Search products..."
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="@dimen/_8sdp"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_12sdp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:background="@drawable/bg_edit_text"
        android:textColorHint="@color/colorAppDarkGrey"
        android:textSize="@dimen/_14ssp"/>

    <HorizontalScrollView
        android:id="@+id/targetAudienceFilterLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:textSize="@dimen/_12ssp"
                android:paddingHorizontal="@dimen/_16sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:background="@drawable/bg_btn_dark_16"
                android:textColor="@color/white"
                android:layout_marginEnd="@dimen/_8sdp"/>

            <TextView
                android:id="@+id/filterMen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Men"
                android:textSize="@dimen/_12ssp"
                android:paddingHorizontal="@dimen/_16sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:background="@drawable/bg_edit_text"
                android:textColor="@color/black"
                android:layout_marginEnd="@dimen/_8sdp"/>

            <TextView
                android:id="@+id/filterWomen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Women"
                android:textSize="@dimen/_12ssp"
                android:paddingHorizontal="@dimen/_16sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:background="@drawable/bg_edit_text"
                android:textColor="@color/black"
                android:layout_marginEnd="@dimen/_8sdp"/>

            <TextView
                android:id="@+id/filterJuniors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Juniors"
                android:textSize="@dimen/_12ssp"
                android:paddingHorizontal="@dimen/_16sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:background="@drawable/bg_edit_text"
                android:textColor="@color/black"
                android:layout_marginEnd="@dimen/_16sdp"/>

        </LinearLayout>
    </HorizontalScrollView>

    <GridView
        android:id="@+id/categoryProductsListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:numColumns="2"
        android:verticalSpacing="@dimen/_8sdp"
        android:horizontalSpacing="@dimen/_8sdp"
        android:padding="@dimen/_8sdp"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay"
        android:background="#F5F5F5"/>

</LinearLayout>
