<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/_20sdp"
    android:background="@color/white">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit Product"
        android:textSize="@dimen/_18ssp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="@dimen/_16sdp"/>

    <EditText
        android:id="@+id/editProductName"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_45sdp"
        android:background="@drawable/bg_edit_text"
        android:paddingHorizontal="@dimen/_12sdp"
        android:hint="Product Name"
        android:textSize="@dimen/_14ssp"
        android:layout_marginBottom="@dimen/_12sdp"/>

    <EditText
        android:id="@+id/editProductPrice"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_45sdp"
        android:background="@drawable/bg_edit_text"
        android:paddingHorizontal="@dimen/_12sdp"
        android:hint="Price"
        android:inputType="numberDecimal"
        android:textSize="@dimen/_14ssp"
        android:layout_marginBottom="@dimen/_12sdp"/>

    <EditText
        android:id="@+id/editProductInventory"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_45sdp"
        android:background="@drawable/bg_edit_text"
        android:paddingHorizontal="@dimen/_12sdp"
        android:hint="Stock/Inventory"
        android:inputType="number"
        android:textSize="@dimen/_14ssp"
        android:layout_marginBottom="@dimen/_12sdp"/>

    <EditText
        android:id="@+id/editProductColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_45sdp"
        android:background="@drawable/bg_edit_text"
        android:paddingHorizontal="@dimen/_12sdp"
        android:hint="Available Colors (e.g., Red, Blue)"
        android:textSize="@dimen/_14ssp"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/_12sdp"/>

    <EditText
        android:id="@+id/editProductSize"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_45sdp"
        android:background="@drawable/bg_edit_text"
        android:paddingHorizontal="@dimen/_12sdp"
        android:hint="Available Sizes (e.g., S, M, L)"
        android:textSize="@dimen/_14ssp"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/_12sdp"/>

    <EditText
        android:id="@+id/editProductDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/_80sdp"
        android:background="@drawable/bg_edit_text"
        android:padding="@dimen/_12sdp"
        android:hint="Description"
        android:gravity="top|start"
        android:textSize="@dimen/_14ssp"
        android:layout_marginBottom="@dimen/_16sdp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelEdit"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_35sdp"
            android:text="Cancel"
            android:textColor="@color/black"
            android:background="@android:color/transparent"
            android:layout_marginEnd="@dimen/_8sdp"
            android:textAllCaps="false"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveEdit"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_35sdp"
            android:text="Save"
            android:textColor="@color/white"
            android:background="@drawable/bg_btn_blue_8"
            android:paddingHorizontal="@dimen/_16sdp"
            android:textAllCaps="false"/>

    </LinearLayout>
</LinearLayout>
