<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Payment" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorAppLightGrey"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_16sdp"
            android:gravity="center">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/_12sdp"
                app:cardElevation="@dimen/_8sdp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="@dimen/_24sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_24sdp"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:layout_width="@dimen/_64sdp"
                        android:layout_height="@dimen/_64sdp"
                        android:src="@drawable/outline_card_travel_24"
                        app:tint="@color/colorAppBlue"
                        android:layout_marginBottom="@dimen/_16sdp"/>

                    <TextView
                        android:id="@+id/tvPaymentTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Complete Payment"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/_24sdp" />

                    <EditText
                        android:id="@+id/etAccountNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Account / Card Number"
                        android:textColor="@color/black"
                        android:textColorHint="@color/colorAppDarkGrey"
                        android:inputType="number"
                        android:minHeight="@dimen/_48sdp"
                        android:layout_marginBottom="@dimen/_16sdp" />

                    <EditText
                        android:id="@+id/etPin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="PIN / CVV"
                        android:textColor="@color/black"
                        android:textColorHint="@color/colorAppDarkGrey"
                        android:inputType="numberPassword"
                        android:minHeight="@dimen/_48sdp"
                        android:layout_marginBottom="@dimen/_24sdp" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:indeterminateTint="@color/colorAppBlue"
                        android:layout_marginBottom="@dimen/_16sdp"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnPayNow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pay Now"
                        android:textSize="16sp"
                        android:padding="@dimen/_12sdp"
                        android:background="@drawable/bg_btn_blue_8"
                        android:textColor="@color/white"
                        android:textAllCaps="false"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
