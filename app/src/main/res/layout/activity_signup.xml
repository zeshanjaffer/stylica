<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
<LinearLayout
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/_24sdp"
    android:background="#FFFFFF">


    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="@dimen/_160sdp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_new"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/_16sdp"/>


    <TextView
        android:id="@+id/titleLoginText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/signup_title"
        android:textColor="@color/black"
        android:textSize="22sp"
        android:layout_marginTop="0dp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/firstNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/firstname_text"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/_16sdp"
        android:textStyle="bold"/>
    <EditText
        android:id="@+id/firstnameInput"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:hint="@string/firstname_hint"
        android:inputType="textPersonName"
        android:paddingHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/bg_edit_text"
        android:layout_marginBottom="@dimen/_16sdp"/>

    <TextView
        android:id="@+id/lastNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lastname_text"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/_8sdp"
        android:textStyle="bold"/>
    <EditText
        android:id="@+id/lastnameInput"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:hint="@string/lastname_hint"
        android:inputType="textPersonName"
        android:paddingHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/bg_edit_text"
        android:layout_marginBottom="@dimen/_16sdp"/>

    <TextView
        android:id="@+id/EmailText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/email_text"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/_8sdp"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/emailInput"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:hint="@string/email_hint"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/bg_edit_text"
        android:layout_marginBottom="@dimen/_16sdp"/>

    <TextView
        android:id="@+id/passwordText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/password_text"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/_8sdp"
        android:textStyle="bold"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        app:hintEnabled="false"
        app:passwordToggleEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:hint="@string/password_hint"
            android:inputType="textPassword"
            android:paddingHorizontal="@dimen/_16sdp"
            android:background="@drawable/bg_edit_text" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/retypePasswordText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/retypePassword_text"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/_8sdp"
        android:textStyle="bold"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        app:hintEnabled="false"
        app:passwordToggleEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/retypePasswordInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:hint="@string/retypePassword_hint"
            android:inputType="textPassword"
            android:paddingHorizontal="@dimen/_16sdp"
            android:background="@drawable/bg_edit_text" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gender"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/_8sdp"/>
    <Spinner
        android:id="@+id/spinnerGender"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_16sdp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contact number"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:textStyle="bold"/>
    <EditText
        android:id="@+id/phoneInput"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:hint="Phone"
        android:inputType="phone"
        android:paddingHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/bg_edit_text"
        android:layout_marginBottom="@dimen/_16sdp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Address"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:textStyle="bold"/>
    <EditText
        android:id="@+id/addressInput"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_80sdp"
        android:hint="Address"
        android:gravity="top"
        android:inputType="textPostalAddress|textMultiLine"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingVertical="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/bg_edit_text"
        android:layout_marginBottom="@dimen/_16sdp"/>

    <RadioGroup
        android:id="@+id/roleGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp">

        <RadioButton
            android:id="@+id/radioUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User"
            android:textColor="@color/black"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/radioAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:text="Admin"/>

        <RadioButton
            android:id="@+id/radioModerator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:text="Moderator"/>
    </RadioGroup>

    <LinearLayout
        android:id="@+id/domainLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product domain (moderator)"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/_8sdp"/>
        <EditText
            android:id="@+id/domainInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:hint="e.g. Headwear, Footwear"
            android:paddingHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_edit_text"
            android:layout_marginBottom="@dimen/_8sdp"/>
    </LinearLayout>
    
    <Button
        android:id="@+id/registerBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56sdp"
        android:text="@string/register_btn"
        android:textSize="16sp"
        android:background="@drawable/bg_btn_dark_16"
        android:layout_marginTop="@dimen/_24sdp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/loginBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56sdp"
        android:text="@string/login_btn"
        android:textSize="16sp"
        android:background="@drawable/bg_btn_blue_16"
        android:layout_marginTop="@dimen/_16sdp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"/>



</LinearLayout>
</ScrollView>