<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="@dimen/_24sdp">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="@dimen/_160sdp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_new"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/_16sdp"/>

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="@dimen/_24sdp"
            />

        <TextView
            android:id="@+id/titleLoginText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_title2"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/EmailText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/email_text"
            android:textSize="14sp"
            android:layout_marginTop="@dimen/_16sdp"
            android:textColor="@color/black"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:hint="@string/email_hint"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_edit_text"
            android:layout_marginBottom="@dimen/_16sdp"/>

        <TextView
            android:id="@+id/passwordText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/password_text"
            android:textSize="14sp"
            android:layout_marginTop="@dimen/_8sdp"
            android:textColor="@color/black"
            android:textStyle="bold"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_16sdp"
            app:hintEnabled="false"
            app:passwordToggleEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_50sdp"
                android:hint="@string/password_hint"
                android:inputType="textPassword"
                android:paddingHorizontal="@dimen/_16sdp"
                android:background="@drawable/bg_edit_text" />
                
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:id="@+id/captchaQuestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5 + 3 = ?"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginTop="@dimen/_8sdp"/>

        <EditText
            android:id="@+id/captchaInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:hint="Enter captcha answer"
            android:inputType="number"
            android:paddingHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_edit_text"/>

        <Button
            android:id="@+id/loginBtn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_56sdp"
            android:text="@string/login_btn"
            android:textSize="16sp"
            android:background="@drawable/bg_btn_dark_16"
            android:layout_marginTop="@dimen/_24sdp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/registerBtn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_56sdp"
            android:text="@string/register_btn"
            android:textSize="16sp"
            android:background="@drawable/bg_btn_blue_16"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_24sdp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>
