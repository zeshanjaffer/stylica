<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/_8sdp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Moderator products by category"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/black"/>

    <EditText
        android:id="@+id/etCategoryFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Category filter (e.g. Clothes, Makeup, Headwear)"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/_8sdp"/>

    <Button
        android:id="@+id/btnLoadModProducts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Load"
        android:background="@drawable/bg_btn_dark_16"
        android:textColor="@color/white"
        android:layout_marginTop="@dimen/_8sdp"/>

    <TextView
        android:id="@+id/tvEmptyModProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No products"
        android:visibility="gone"/>

    <GridView
        android:id="@+id/gridModProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="2"
        android:horizontalSpacing="@dimen/_8sdp"
        android:verticalSpacing="@dimen/_8sdp"/>
</LinearLayout>
